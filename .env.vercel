APP_NAME=AniVerse
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aniteph.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=info

# Stateless: cookie-only sessions (no DB or file writes required)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Stateless: run queued jobs synchronously inside the request
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

# Stateless: in-memory cache (cleared every request — fine since Vercel is stateless anyway)
# Use "array" so we never touch the filesystem. APIs (AniList/Anikoto) will be hit more often,
# but the app will work.
CACHE_STORE=array

# DB is not needed for read-only browsing pages. With CACHE_STORE=array and no Queue writes,
# nothing tries to touch sqlite. We still need a valid DB_CONNECTION for Laravel boot, so we
# point everything to a tmp file path.
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ANIKOTO_API_URL=https://anikotoapi.site
