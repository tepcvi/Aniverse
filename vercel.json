{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build || true",
  "installCommand": "composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader && npm install --ignore-scripts",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "outputDirectory": "public"
}
